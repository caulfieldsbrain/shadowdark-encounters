{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",

    "inlineSourceMap": true,
    "inlineSources": true,

    "module": "ESNext",
    "target": "ES2020",

    "allowJs": true,
    "noImplicitAny": true,

    "moduleResolution": "bundler",

    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,

    "lib": ["DOM", "ES2020"]
  },
  "include": ["src/**/*.ts"]
}